<div class="card">
  <div class="card-body">
    <h1 class="card-category">
      <%= room.current_card.category %>
    </h1>
  </div>
  <% if viewer == room.drawer_player %>
    <h1 class="card-text">
      Fact: <%= room.current_card.fact %>
    </h1>
    <h2 class="card-title">
      Correct answer: <%= room.current_card.title %>
    </h2>
  <% end %>
</div>
