<div class="card">
  <div class="card-body">
    <h1 class="card-category">
      <%= room.current_card.category %>
    </h1>
  </div>
  <% if viewer == room.drawer_player %>
    <h1 class="card-text">
      Fact: <%= room.current_card.fact %>
    </h1>
    <% if room.current_card.incorrect_answers.present? %>
      <h2 class="answer-title">Incorrect answers:</h2>
      <ul class="incorrect-answers">
        <% room.current_card.incorrect_answers.each do |answer| %>
          <li><strong><%= answer %></strong></li>
        <% end %>
      </ul>
    <% end %>
    <h2 class="card-title">
      Correct answer: <%= room.current_card.title %>
    </h2>
  <% end %>
</div>
