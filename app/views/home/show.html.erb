<div class="home-page">
  <%= video_tag(
        "5839090-hd_1080_1920_24fps.mp4",
        loop: true,
        autoplay: true,
        muted: true,
        playsinline: true,
        class: "background-video",
      ) %>
  <div class="home-content">
    <h1 class="game-title">History or Mystery?</h1>
    <div class="form-wrapper">
      <%= form_with url: rooms_path, method: :post do |f| %>
        <%= f.text_field :name, placeholder: "Your name" %>
        <%= f.submit "Create Room" %>
      <% end %>
      <div class="join-wrapper">
        <%= form_with url: join_path, method: :post do |f| %>
          <%= f.text_field :code, placeholder: "Room code" %>
          <%= f.text_field :name, placeholder: "Your name" %>
          <%= f.submit "Join Room" %>
        <% end %>
      </div>
    </div>
  </div>
</div>