<div class="game-room">
  <%= image_tag(
        "logo-3.svg",
        class: "game-logo",
      ) %>
  <% if room.players.count < 2 %>
    <h1> Room code: <%= room.code %> </h1>
    <h2>Waiting for the second player to join...</h2>
  <% elsif room.players.count == 2 && room.round_status.blank?%>
    <h1 class="game-title">History or Mystery?</h1>
    <% if viewer.seat == "a" %>
      <%= form_with url: start_round_path(room), method: :post do %>
        <button>Start game</button>
      <% end %>
    <% else %>
      <h2>Waiting for the host to start the game...</h2>
    <% end %>
  <% elsif room.round_status == "active" %>
    <% if notice %>
      <p class="flash-notice"><%= notice %></p>
    <% end %>
    <%= render "cards/card", room: room, viewer: viewer %>
    <% if viewer == room.drawer_player %>
      <div class="drawer-actions">
        <% if room.clue_revealed == true && room.clue_text.blank? %>
          <%= form_with url: submit_clue_path(room), method: :post do |f| %>
            <%= f.text_field :clue, placeholder: "Clue" %>
            <%= f.submit "Reveal clue", class: "player-button" %>
          <% end %>
        <% end %>
        <%= button_to "Correct!", resolve_round_path(room), class: "player-button", method: :post, params: { outcome: "won" } %>
        <%= button_to "Incorrect", resolve_round_path(room), class: "player-button", method: :post, params: { outcome: "incorrect" } %>
      </div>
    <% elsif viewer == room.guesser_player %>
      <div class="guesser-actions">
        <% if room.clue_revealed == false %>
          <%= form_with url: request_clue_path(room), method: :post do %>
            <button class="player-button">Clued in 🔎</button>
          <% end %>
        <% else %>
          <%= render "cards/clue", room: room, viewer: viewer %>
        <% end %>
        <%= button_to "Forfeit", resolve_round_path(room), class: "player-button", method: :post, params: { outcome: "forfeit" } %>
      </div>
    <% end %>
  <% elsif room.round_status == "finished" || room.round_status == "forfeited" || room.round_status == "won" %>
    <div class="game-status-wrapper">
      <% if viewer == room.winner_player %>
        <div class="win-wrapper">
          <h1 class="card-title">You won! 🎉</h1>
        </div>
      <% else %>
        <div class="forfeit-wrapper">
          <h1 class="card-title">Game Over</h1>
        </div>
      <% end %>
      <% if viewer == room.guesser_player%>
        <h2 class="card-question">
          The question was: <%= room.current_card.fact %>
        </h2>
        <h2 class="card-title">
          The correct answer was: <%= room.current_card.title %>
        </h2>
      <% end %>
    </div>
    <%= link_to "Main menu", root_path %>
  <% end %>
</div>